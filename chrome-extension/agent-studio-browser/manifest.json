{
  "manifest_version": 3,
  "name": "Agent Studio Browser",
  "version": "0.1.0",
  "description": "把 Chrome Cookie 同步到 Agent Studio 内置浏览器，并上报窗口几何。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Studio Browser",
    "default_popup": "popup.html"
  }
}
